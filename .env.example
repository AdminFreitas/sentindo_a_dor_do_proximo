# ============================================================
# Sentindo a Dor do Próximo — Variáveis de Ambiente (.env.example)
# Copie este arquivo para .env e preencha com valores reais.
# O arquivo .env real NUNCA deve ser commitado (já incluído no .gitignore).
# ============================================================

# ------------------------------------------------------------
# 1. Banco de dados (Docker Compose / Postgres)
# ------------------------------------------------------------
# Usuário admin/dono, usado só pelo Postgres para inicializar o container
# e rodar migrations (Dono do schema). NÃO é o usuário que o Backend usa em runtime.
# Ver docs/BANCO_DADOS.md, seção 3, e docs/SDP_DECISOES_PENDENTES.md, T04.
DB_NAME=sentindo_a_dor_do_proximo
DB_ADMIN_USER=db_owner
DB_ADMIN_PASSWORD=

# Usuário de runtime da aplicação (app_runtime, criado em db/init/db_init.sql).
# A senha abaixo deve ser a mesma colocada dentro de db/init/db_init.sql.
APP_DB_USER=app_runtime
APP_DB_PASSWORD=

# ------------------------------------------------------------
# 2. Conexão do Backend (SQLAlchemy / asyncpg)
# ------------------------------------------------------------
# String de conexão usada pela aplicação FastAPI em tempo de execução.
DATABASE_URL=postgresql+asyncpg://app_runtime:troque_esta_senha@localhost:5432/sentindo_a_dor_do_proximo

# ------------------------------------------------------------
# 3. Sessão / Cookies (docs/SEGURANCA.md, Regra 10)
# ------------------------------------------------------------
SESSION_COOKIE_NAME=sdp_session
SESSION_TTL_MINUTOS=30
# Defina como "true" apenas em ambientes com HTTPS real (staging/produção).
# Em ambiente de desenvolvimento local sem HTTPS, use "false".
SESSION_COOKIE_SECURE=false

# ------------------------------------------------------------
# 4. Rate Limiting de Login (docs/SEGURANCA.md, Regra 14)
# ------------------------------------------------------------
LOGIN_MAX_TENTATIVAS=5
LOGIN_JANELA_SEGUNDOS=300

# ------------------------------------------------------------
# 5. Ambiente da Aplicação
# ------------------------------------------------------------
# Valores permitidos: development | staging | production (ver T07 em SDP_DECISOES_PENDENTES.md)
APP_ENV=development
